# Local PostgreSQL database. Create this database before running migrations.
DATABASE_URL="postgresql://gomgoods:gomgoods@localhost:5432/gomgoods?schema=public"
NODE_ENV="development"
PORT="3000"
JWT_ACCESS_SECRET="replace-with-a-local-secret-of-at-least-32-characters"
JWT_ACCESS_TTL="15m"
JWT_ISSUER="gomgoods-api"
JWT_AUDIENCE="gomgoods-frontend"
AUTH_REFRESH_TTL_DAYS="30"
AUTH_REFRESH_GRACE_SECONDS="10"
# Configure these for the actual deployment topology. SameSite=None requires Secure=true.
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_DOMAIN=""
CORS_ORIGINS="http://localhost:3001"
SWAGGER_ENABLED="true"
# Local seed users share this password. Never use it outside local development.
SEED_USER_PASSWORD="replace-with-a-local-only-password"
