generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Account and catalogue
enum AccountType {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  INACTIVE
  REMOVED
}

// Commerce
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  E_WALLET
  CREDIT_CARD
  DEBIT_CARD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
  LOST
  CANCELLED
}

// Marketplace workflows
enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// Community and support
enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReactionType {
  LIKE
  LOVE
  WOW
  SAD
  ANGRY
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum ReportTargetType {
  USER
  STORE
  PRODUCT
  LISTING
  POST
  COMMENT
  MESSAGE
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

model User {
  id           String      @id @default(uuid()) @map("user_id") @db.Uuid
  email        String      @unique @db.VarChar(320)
  username     String      @unique @db.VarChar(50)
  passwordHash String      @map("password") @db.VarChar(255)
  accountType  AccountType @default(USER) @map("account_type")
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses                 Address[]
  store                     Store?
  following                 Follow[]
  followingUsers            UserFollow[]              @relation("UserFollowing")
  followers                 UserFollow[]              @relation("UserFollowers")
  cart                      Cart?
  checkoutGroups            CheckoutGroup[]
  listings                  Listing[]                 @relation("PersonalListings")
  collections               Collection[]
  orders                    Order[]
  sellerOrders              Order[]                   @relation("OrderSellerUser")
  shipmentSellerAssignments Shipment[]                @relation("ShipmentSellerUser")
  auctionWins               Auction[]                 @relation("AuctionWinner")
  bids                      Bid[]
  disputes                  Dispute[]
  campaignParticipations    CampaignParticipant[]
  posts                     Post[]
  comments                  Comment[]
  reactions                 Reaction[]
  conversationParticipants  ConversationParticipant[]
  messages                  Message[]
  buyerConversations        Conversation[] @relation("ChatBuyer")
  sellerConversations       Conversation[] @relation("ChatSeller")
  reviews                   Review[]
  reports                   Report[]
  forumModerationActions    ForumModerationAction[]
  forumLikeEvents           ForumLikeEvent[]
  supportTickets            SupportTicket[]
  authSessions              AuthSession[]

  @@map("USER")
}

model AuthSession {
  id                String    @id @default(uuid()) @map("session_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  currentGeneration Int       @default(0) @map("current_generation")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason  String?   @map("revocation_reason") @db.VarChar(40)

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials RefreshCredential[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("AUTH_SESSION")
}

model RefreshCredential {
  sessionId String    @map("session_id") @db.Uuid
  generation Int
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, generation])
  @@map("REFRESH_CREDENTIAL")
}

model Address {
  id          String   @id @default(uuid()) @map("address_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  recipient   String   @db.VarChar(150)
  phone       String   @db.VarChar(30)
  addressLine String   @map("address_line") @db.VarChar(255)
  city        String   @db.VarChar(100)
  district    String   @db.VarChar(100)
  ward        String   @db.VarChar(100)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("ADDRESS")
}

model Store {
  id          String      @id @default(uuid()) @map("store_id") @db.Uuid
  userId      String      @unique @map("user_id") @db.Uuid
  name        String      @map("store_name") @db.VarChar(150)
  description String?     @db.Text
  avatarUrl   String?     @map("avatar_url") @db.Text
  status      StoreStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  products  Product[]
  followers Follow[]
  orders    Order[]    @relation("OrderStore")
  shipments Shipment[] @relation("ShipmentStore")

  @@index([status])
  @@map("STORE")
}

model Follow {
  id        String   @id @default(uuid()) @map("follow_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("FOLLOW")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@index([followerId, createdAt])
  @@map("USER_FOLLOW")
}

model Category {
  id          String         @id @default(uuid()) @map("category_id") @db.Uuid
  parentId    String?        @map("parent_id") @db.Uuid
  name        String         @db.VarChar(120)
  description String?        @db.Text
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([parentId, name])
  @@index([status])
  @@map("CATEGORY")
}

model Product {
  id          String        @id @default(uuid()) @map("product_id") @db.Uuid
  storeId     String        @map("store_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String        @db.VarChar(200)
  description String?       @db.Text
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  listings Listing[]

  @@index([storeId, status])
  @@index([categoryId, status])
  @@map("PRODUCT")
}

model Listing {
  id           String           @id @default(uuid()) @map("listing_id") @db.Uuid
  productId    String?          @map("product_id") @db.Uuid
  sellerUserId String?          @map("seller_user_id") @db.Uuid
  price        Decimal          @db.Decimal(14, 2)
  quantity     Int
  condition    ListingCondition
  description  String?          @db.Text
  status       ListingStatus    @default(DRAFT)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  product         Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sellerUser      User?            @relation("PersonalListings", fields: [sellerUserId], references: [id], onDelete: Restrict)
  images          ListingImage[]
  collectionItems CollectionItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  auction         Auction?

  @@index([productId, status])
  @@index([sellerUserId, status])
  @@index([status, createdAt])
  @@map("LISTING")
}

model Cart {
  id        String     @id @default(uuid()) @map("cart_id") @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("CART")
}

model CartItem {
  id        String   @id @default(uuid()) @map("cart_item_id") @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@unique([cartId, listingId])
  @@index([listingId])
  @@map("CART_ITEM")
}

model ListingImage {
  id        String @id @default(uuid()) @map("image_id") @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  imageUrl  String @map("image_url") @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, sortOrder])
  @@map("LISTING_IMAGE")
}

model Collection {
  id          String   @id @default(uuid()) @map("collection_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId, createdAt])
  @@map("COLLECTION")
}

model CollectionItem {
  id           String   @id @default(uuid()) @map("collection_item_id") @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  listingId    String   @map("listing_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listing    Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([collectionId, listingId])
  @@index([listingId])
  @@map("COLLECTION_ITEM")
}

model Order {
  id                  String      @id @default(uuid()) @map("order_id") @db.Uuid
  checkoutGroupId     String?     @map("checkout_group_id") @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  addressId           String      @map("address_id") @db.Uuid
  sellerUserId        String?     @map("seller_user_id") @db.Uuid
  storeId             String?     @map("store_id") @db.Uuid
  total               Decimal     @map("total_amount") @db.Decimal(14, 2)
  paymentMethod       PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  status              OrderStatus @default(PENDING)
  note                String?     @db.Text
  expiresAt           DateTime?   @map("expires_at") @db.Timestamptz(6)
  cancelledAt         DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelReason        String?     @map("cancel_reason") @db.Text
  shippingRecipient   String      @default("") @map("shipping_recipient") @db.VarChar(150)
  shippingPhone       String      @default("") @map("shipping_phone") @db.VarChar(30)
  shippingAddressLine String      @default("") @map("shipping_address_line") @db.VarChar(255)
  shippingCity        String      @default("") @map("shipping_city") @db.VarChar(100)
  shippingDistrict    String      @default("") @map("shipping_district") @db.VarChar(100)
  shippingWard        String      @default("") @map("shipping_ward") @db.VarChar(100)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkoutGroup CheckoutGroup? @relation(fields: [checkoutGroupId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  address       Address        @relation(fields: [addressId], references: [id], onDelete: Restrict)
  sellerUser    User?          @relation("OrderSellerUser", fields: [sellerUserId], references: [id], onDelete: Restrict)
  store         Store?         @relation("OrderStore", fields: [storeId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      Payment[]
  shipments     Shipment[]
  disputes      Dispute[]

  @@index([userId, createdAt])
  @@index([checkoutGroupId])
  @@index([sellerUserId, createdAt])
  @@index([storeId, createdAt])
  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@map("ORDER")
}

model OrderItem {
  id                         String   @id @default(uuid()) @map("order_item_id") @db.Uuid
  orderId                    String   @map("order_id") @db.Uuid
  listingId                  String   @map("listing_id") @db.Uuid
  quantity                   Int
  unitPrice                  Decimal  @map("unit_price") @db.Decimal(14, 2)
  subtotal                   Decimal  @db.Decimal(14, 2)
  listingDescriptionSnapshot String?  @map("listing_description_snapshot") @db.Text
  productIdSnapshot          String?  @map("product_id_snapshot") @db.Uuid
  productNameSnapshot        String?  @map("product_name_snapshot") @db.VarChar(200)
  storeNameSnapshot          String?  @map("store_name_snapshot") @db.VarChar(150)
  sellerUsernameSnapshot     String?  @map("seller_username_snapshot") @db.VarChar(50)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing       Listing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  shipmentItems ShipmentItem[]
  review        Review?
  disputes      Dispute[]

  @@index([listingId])
  @@map("ORDER_ITEM")
}

model CheckoutGroup {
  id             String   @id @default(uuid()) @map("checkout_group_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(120)
  requestHash    String   @map("request_hash") @db.Char(64)
  total          Decimal  @map("total_amount") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders Order[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("CHECKOUT_GROUP")
}

model Payment {
  id        String        @id @default(uuid()) @map("payment_id") @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  events       PaymentEvent[]

  @@index([orderId, status])
  @@map("PAYMENT")
}

enum PaymentEventProvider {
  MOCK
  SEPAY_TEST
}

enum PaymentEventStatus {
  RECEIVED
  APPLIED
  REJECTED
  IGNORED
}

model PaymentEvent {
  id               String               @id @default(uuid()) @map("payment_event_id") @db.Uuid
  provider         PaymentEventProvider
  providerEventId  String               @map("provider_event_id") @db.VarChar(120)
  bankReference    String?              @map("bank_reference") @db.VarChar(150)
  payloadHash      String               @map("payload_hash") @db.Char(64)
  accountNumber    String               @map("account_number") @db.VarChar(30)
  gateway          String               @db.VarChar(100)
  paymentReference String?              @map("payment_reference") @db.VarChar(50)
  amount           Decimal              @db.Decimal(14, 2)
  transferType     String               @map("transfer_type") @db.VarChar(3)
  occurredAt       DateTime             @map("occurred_at") @db.Timestamptz(6)
  status           PaymentEventStatus   @default(RECEIVED)
  reason           String?              @db.VarChar(100)
  paymentId        String?              @map("payment_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@unique([provider, accountNumber, gateway, bankReference], map: "PAYMENT_EVENT_bank_reference_key")
  @@index([status, createdAt])
  @@index([paymentId])
  @@map("PAYMENT_EVENT")
}

model Transaction {
  id              String            @id @default(uuid()) @map("transaction_id") @db.Uuid
  paymentId       String            @map("payment_id") @db.Uuid
  transactionCode String            @unique @map("transaction_code") @db.VarChar(150)
  amount          Decimal           @db.Decimal(14, 2)
  status          TransactionStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("TRANSACTION")
}

model Shipment {
  id           String         @id @default(uuid()) @map("shipment_id") @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  sellerUserId String?        @map("seller_user_id") @db.Uuid
  storeId      String?        @map("store_id") @db.Uuid
  carrier      String         @db.VarChar(100)
  trackingNo   String?        @unique @map("tracking_number") @db.VarChar(150)
  shippingFee  Decimal        @map("shipping_fee") @db.Decimal(14, 2)
  status       ShipmentStatus @default(PENDING)
  shippedAt    DateTime?      @map("shipped_at") @db.Timestamptz(6)
  deliveredAt  DateTime?      @map("delivered_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerUser User?          @relation("ShipmentSellerUser", fields: [sellerUserId], references: [id], onDelete: Restrict)
  store      Store?         @relation("ShipmentStore", fields: [storeId], references: [id], onDelete: Restrict)
  items      ShipmentItem[]

  @@index([orderId, status])
  @@index([sellerUserId])
  @@index([storeId])
  @@map("SHIPMENT")
}

model ShipmentItem {
  id          String @id @default(uuid()) @map("shipment_item_id") @db.Uuid
  shipmentId  String @map("shipment_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("SHIPMENT_ITEM")
}

model Auction {
  id            String        @id @default(uuid()) @map("auction_id") @db.Uuid
  listingId     String        @unique @map("listing_id") @db.Uuid
  startingPrice Decimal       @map("starting_price") @db.Decimal(14, 2)
  bidStep       Decimal       @map("bid_step") @db.Decimal(14, 2)
  startsAt      DateTime      @map("start_time") @db.Timestamptz(6)
  endsAt        DateTime      @map("end_time") @db.Timestamptz(6)
  winnerId      String?       @map("winner_id") @db.Uuid
  winningBid    Decimal?      @map("winning_bid") @db.Decimal(14, 2)
  status        AuctionStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  winner  User?   @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: Restrict)
  bids    Bid[]

  @@index([status, endsAt])
  @@map("AUCTION")
}

model Bid {
  id        String   @id @default(uuid()) @map("bid_id") @db.Uuid
  auctionId String   @map("auction_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([auctionId, createdAt])
  @@index([userId, createdAt])
  @@map("BID")
}

model Dispute {
  id          String        @id @default(uuid()) @map("dispute_id") @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  orderItemId String?       @map("order_item_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  reason      String        @db.VarChar(255)
  description String?       @db.Text
  status      DisputeStatus @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz(6)

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  evidence  DisputeEvidence[]

  @@index([orderId, status])
  @@index([userId, createdAt])
  @@map("DISPUTE")
}

model DisputeEvidence {
  id          String   @id @default(uuid()) @map("evidence_id") @db.Uuid
  disputeId   String   @map("dispute_id") @db.Uuid
  evidenceUrl String   @map("evidence_url") @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("DISPUTE_EVIDENCE")
}

model Campaign {
  id          String         @id @default(uuid()) @map("campaign_id") @db.Uuid
  name        String         @db.VarChar(200)
  description String?        @db.Text
  startsAt    DateTime       @map("start_time") @db.Timestamptz(6)
  endsAt      DateTime       @map("end_time") @db.Timestamptz(6)
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  participants CampaignParticipant[]

  @@index([status, startsAt])
  @@map("CAMPAIGN")
}

model CampaignParticipant {
  id         String   @id @default(uuid()) @map("participant_id") @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  score      Int      @default(0)
  joinedAt   DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("CAMPAIGN_PARTICIPANT")
}

model Post {
  id        String     @id @default(uuid()) @map("post_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  title     String     @db.VarChar(250)
  content   String     @db.Text
  status    PostStatus @default(DRAFT)
  topicId   String     @map("topic_id") @db.Uuid
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)
  hiddenAt  DateTime?  @map("hidden_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  comments  Comment[]
  reactions Reaction[]
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  reports   Report[]
  moderationActions ForumModerationAction[]
  likeEvents ForumLikeEvent[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([topicId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@map("POST")
}

model ForumTopic {
  id String @id @default(uuid()) @map("topic_id") @db.Uuid
  slug String @unique @db.VarChar(50)
  name String @db.VarChar(120)
  active Boolean @default(true)
  posts Post[]

  @@map("FORUM_TOPIC")
}

// Independent operational counters. No domain relation or content is stored.
model ForumRateLimit {
  userId String @map("user_id") @db.Uuid
  operation String @db.VarChar(30)
  requestCount Int @map("request_count")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([userId, operation])
  @@index([expiresAt])
  @@map("FORUM_RATE_LIMIT")
}

// Append-only application events freeze popular-feed rankings across cursor pages.
// Reaction remains the canonical, unique current user/post like state.
model ForumLikeEvent {
  sequence BigInt @id @default(autoincrement())
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  liked Boolean
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, userId, sequence(sort: Desc)])
  @@map("FORUM_LIKE_EVENT")
}

model Comment {
  id        String   @id @default(uuid()) @map("comment_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.Text
  parentId  String?  @map("parent_id") @db.Uuid
  status    PostStatus @default(PUBLISHED)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  hiddenAt  DateTime? @map("hidden_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent Comment? @relation("ForumReplies", fields: [postId, parentId], references: [postId, id], onDelete: NoAction, onUpdate: NoAction)
  replies Comment[] @relation("ForumReplies")
  reports Report[]
  moderationActions ForumModerationAction[]

  @@unique([postId, id])
  @@index([postId, createdAt])
  @@index([postId, status, createdAt, id])
  @@index([userId])
  @@map("COMMENT")
}

model Reaction {
  id        String       @id @default(uuid()) @map("reaction_id") @db.Uuid
  postId    String       @map("post_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("REACTION")
}

model Conversation {
  id        String   @id @default(uuid()) @map("conversation_id") @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  sellerUserId String @map("seller_user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  storeId   String?  @map("store_id") @db.Uuid
  contextSnapshot Json @map("context_snapshot")
  lastSequence BigInt @default(0) @map("last_sequence")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  participants ConversationParticipant[]
  messages     Message[]
  buyer User @relation("ChatBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller User @relation("ChatSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)

  @@unique([buyerId, listingId])
  @@index([updatedAt, id])
  @@map("CONVERSATION")
}

model ConversationParticipant {
  id             String   @id @default(uuid()) @map("participant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastDeliveredSequence BigInt @default(0) @map("last_delivered_sequence")
  lastReadSequence BigInt @default(0) @map("last_read_sequence")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMessages Message[] @relation("ChatMembershipSender")

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
  @@map("CONVERSATION_PARTICIPANT")
}

model Message {
  id             String        @id @default(uuid()) @map("message_id") @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  senderId       String        @map("sender_id") @db.Uuid
  content        String        @db.Text
  status         MessageStatus @default(SENT)
  sentAt         DateTime      @default(now()) @map("sent_at") @db.Timestamptz(6)
  sequence       BigInt
  clientMessageId String @map("client_message_id") @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  membership ConversationParticipant @relation("ChatMembershipSender", fields: [conversationId, senderId], references: [conversationId, userId], onDelete: Restrict, map: "MESSAGE_membership_fkey")

  @@unique([conversationId, sequence])
  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, sentAt])
  @@index([senderId])
  @@map("MESSAGE")
}

model Review {
  id            String   @id @default(uuid()) @map("review_id") @db.Uuid
  orderItemId   String   @unique @map("order_item_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  productRating Int?     @map("product_rating") @db.SmallInt
  sellerRating  Int?     @map("seller_rating") @db.SmallInt
  comment       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("REVIEW")
}

model Report {
  id         String           @id @default(uuid()) @map("report_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  reason     String           @db.VarChar(255)
  content    String?          @db.Text
  status     ReportStatus     @default(OPEN)
  postId     String?          @map("forum_post_id") @db.Uuid
  commentId  String?          @map("forum_comment_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  post Post? @relation(fields: [postId], references: [id], onDelete: Restrict)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Restrict)
  moderationActions ForumModerationAction[]

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@map("REPORT")
}

model ForumModerationAction {
  id String @id @default(uuid()) @map("action_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  postId String @map("post_id") @db.Uuid
  commentId String? @map("comment_id") @db.Uuid
  reportId String? @map("report_id") @db.Uuid
  action String @db.VarChar(30)
  fromStatus String @map("from_status") @db.VarChar(30)
  toStatus String @map("to_status") @db.VarChar(30)
  note String @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  post Post @relation(fields: [postId], references: [id], onDelete: Restrict)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Restrict)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([postId, createdAt])
  @@index([reportId, createdAt])
  @@map("FORUM_MODERATION_ACTION")
}

model SupportTicket {
  id          String              @id @default(uuid()) @map("ticket_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  subject     String              @db.VarChar(250)
  description String              @db.Text
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt    DateTime?           @map("closed_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("SUPPORT_TICKET")
}
