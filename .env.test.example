# This database must be separate from DATABASE_URL and its name must contain "test".
DATABASE_URL="postgresql://gomgoods:gomgoods@localhost:5432/gomgoods?schema=public"
TEST_DATABASE_URL="postgresql://gomgoods:gomgoods@localhost:5432/gomgoods_test?schema=public"
NODE_ENV="test"
PORT="3000"
JWT_ACCESS_SECRET="test-only-secret-with-at-least-32-characters"
JWT_ACCESS_TTL="15m"
JWT_ISSUER="gomgoods-api-test"
JWT_AUDIENCE="gomgoods-frontend-test"
CORS_ORIGINS="http://localhost:3001"
SWAGGER_ENABLED="false"
